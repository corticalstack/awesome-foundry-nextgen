<mxfile host="drawio" type="device">
  <diagram id="track-a" name="Track A">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Track A: per-user news access through a wrapper you own" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="userA" value='User A&lt;br&gt;&lt;span style="font-size:12px"&gt;News.Read.All&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="150" height="64" as="geometry"/></mxCell>
        <mxCell id="userB" value='User B&lt;br&gt;&lt;span style="font-size:12px"&gt;Sports, Science, Health&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="150" height="64" as="geometry"/></mxCell>
        <mxCell id="client" value='Client app&lt;br&gt;&lt;span style="font-size:12px"&gt;news-desk-client-{suffix}&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="300" width="190" height="84" as="geometry"/></mxCell>
        <mxCell id="entra" value='Entra ID&lt;br&gt;&lt;span style="font-size:12px"&gt;app roles on news-mcp-{suffix}&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="680" y="80" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="agent" value='Agent Service&lt;br&gt;&lt;span style="font-size:12px"&gt;news-desk-agent&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="300" width="240" height="84" as="geometry"/></mxCell>
        <mxCell id="enforce" value="Enforcement point&lt;br&gt;news MCP wrapper&lt;br&gt;(FastMCP on Container Apps)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="282" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="gnews" value='GNews MCP&lt;br&gt;&lt;span style="font-size:12px"&gt;mcp.gnews.io, one API key&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1560" y="300" width="190" height="84" as="geometry"/></mxCell>
        <mxCell id="lane" value="validates the token, maps roles to categories&lt;br&gt;&lt;b&gt;tools/list filtered per user:&lt;/b&gt; user A 10 tools; user B sports, science, health&lt;br&gt;a call to a tool not listed: &lt;code&gt;isError&lt;/code&gt; + denial text, never sent upstream" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=10;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1000" y="480" width="480" height="100" as="geometry"/></mxCell>
        <mxCell id="eA" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="userA" target="client"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="eB" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="userB" target="client"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e1" value="sign in (device code)&lt;br&gt;token for &lt;code&gt;access_agent&lt;/code&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="client" target="entra"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="122"/></Array><mxPoint x="40" y="-26" as="offset"/></mxGeometry></mxCell>
