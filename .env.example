# Shared environment variables for all Foundry Nextgen labs.
  # Copy this file to .env and replace the placeholder values.
  # Authentication uses DefaultAzureCredential (RBAC) — gateway keys are the only secrets.

  CHAT_MODEL=gpt-4.1-mini
  EMBEDDING_MODEL=text-embedding-3-large
  RESEARCH_MODEL=o3-deep-research
  OSS_MODEL=Phi-4
  DR_MODEL=o3-deep-research

  AZURE_SUBSCRIPTION_ID=<your-subscription-id>

  CORE_ENDPOINT=https://aif-core-{suffix}.cognitiveservices.azure.com/
  GATEWAY_URL=https://apim-foundry-{suffix}.azure-api.net/openai

  ALPHA_FOUNDRY_ACCOUNT=aif-spoke-alpha-{suffix}
  ALPHA_FOUNDRY_PROJECT=project-alpha-{suffix}
  ALPHA_FOUNDRY_PROJECT_ENDPOINT=https://aif-spoke-alpha-{suffix}.services.ai.azure.com/api/projects/project-alpha-{suffix}
  ALPHA_FOUNDRY_CORE_CONNECTION=core-alpha
  ALPHA_GATEWAY_KEY=<apim subscription key for alpha>
  ALPHA_HOSTED_ACR_LOGIN_SERVER=acralpha{suffix}.azurecr.io
  ALPHA_MEMORY_FOUNDRY_ACCOUNT=aif-memory-{suffix}
  ALPHA_MEMORY_PROJECT_ENDPOINT=https://aif-memory-{suffix}.services.ai.azure.com/api/projects/project-alpha-memory-{suffix}

  MULTI_ACCOUNT=aif-spoke-multi-{suffix}
  MULTI_ACCOUNT_ENDPOINT=https://aif-spoke-multi-{suffix}.cognitiveservices.azure.com/

  BETA_FOUNDRY_PROJECT=project-beta-{suffix}
  BETA_FOUNDRY_PROJECT_ENDPOINT=https://aif-spoke-multi-{suffix}.services.ai.azure.com/api/projects/project-beta-{suffix}
  BETA_FOUNDRY_CORE_CONNECTION=core-beta
  BETA_GATEWAY_KEY=<apim subscription key for beta>

  DELTA_FOUNDRY_PROJECT=project-delta-{suffix}
  DELTA_FOUNDRY_PROJECT_ENDPOINT=https://aif-spoke-multi-{suffix}.services.ai.azure.com/api/projects/project-delta-{suffix}
  DELTA_FOUNDRY_CORE_CONNECTION=core-delta
  DELTA_GATEWAY_KEY=<apim subscription key for delta>

  GAMMA_FOUNDRY_PROJECT=project-gamma-{suffix}
  GAMMA_FOUNDRY_PROJECT_ENDPOINT=https://aif-spoke-multi-{suffix}.services.ai.azure.com/api/projects/project-gamma-{suffix}
  GAMMA_FOUNDRY_CORE_CONNECTION=core-gamma
  GAMMA_GATEWAY_KEY=<apim subscription key for gamma>

  ADMIN_FOUNDRY_PROJECT=project-admin-{suffix}
  ADMIN_FOUNDRY_PROJECT_ENDPOINT=https://aif-core-{suffix}.services.ai.azure.com/api/projects/project-admin-{suffix}

  OBS_FOUNDRY_PROJECT_ENDPOINT=https://aif-spoke-multi-{suffix}.services.ai.azure.com/api/projects/obs-project
  OBS_APIM_CONNECTION=landing-zone-apim
  OBS_GATEWAY_KEY=<apim subscription key for obs>
  OBS_APP_INSIGHTS_NAME=appi-obs-{suffix}
  OBS_APP_INSIGHTS_CONN_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/;LiveEndpoint=https://<region>.livediagnostics.monitor.azure.com/;ApplicationId=<app-id>
  OBS_RESOURCE_GROUP=rg-foundry-multi-{suffix}

  IQ_FOUNDRY_PROJECT=iq-project
  IQ_FOUNDRY_PROJECT_ENDPOINT=https://aif-spoke-multi-{suffix}.services.ai.azure.com/api/projects/iq-project
  IQ_APIM_CONNECTION=iq-apim-connection
  IQ_SEARCH_ENDPOINT=https://iq-search-{suffix}.search.windows.net
  IQ_SEARCH_NAME=iq-search-{suffix}
  IQ_RESOURCE_GROUP=rg-foundry-multi-{suffix}
  IQ_GATEWAY_KEY=<apim subscription key for iq>
  IQ_AGENT_VERSION='1'

  CU_FOUNDRY_PROJECT_ENDPOINT=https://aif-spoke-multi-{suffix}.services.ai.azure.com/api/projects/cu-project
  CU_APIM_CONNECTION=cu-apim-connection
  CU_GATEWAY_KEY=<apim subscription key for cu>

  DR_GATEWAY_KEY=<apim subscription key for deep research>

  CONTOSO_FOUNDRY_PROJECT=contoso-project
  CONTOSO_FOUNDRY_PROJECT_ENDPOINT=https://aif-spoke-multi-{suffix}.services.ai.azure.com/api/projects/contoso-project
  CONTOSO_APIM_CONNECTION=contoso-apim-connection
  CONTOSO_SEARCH_ENDPOINT=https://contoso-search-{suffix}.search.windows.net
  CONTOSO_SEARCH_NAME=contoso-search-{suffix}
  CONTOSO_RESOURCE_GROUP=rg-foundry-multi-{suffix}
  CONTOSO_GATEWAY_KEY=<apim subscription key for contoso>
  CONTOSO_LIVE_TESTS=0

  CONTOSO_PMO_FOUNDRY_PROJECT_ENDPOINT=https://aif-spoke-multi-{suffix}.services.ai.azure.com/api/projects/contoso-pmo-project
  CONTOSO_PMO_RESOURCE_GROUP=rg-foundry-multi-{suffix}
  CONTOSO_PMO_FUNC_APP_NAME=func-contoso-pmo-{suffix}
  CONTOSO_PMO_MCP_RESOURCE_GROUP=rg-contoso-pmo-mcp-{suffix}
  CONTOSO_PMO_MCP_LOCATION=swedencentral

  PRIVATE_BANKING_FUNC_APP_NAME=func-private-banking-{suffix}
  PRIVATE_BANKING_MCP_RESOURCE_GROUP=rg-private-banking-mcp-{suffix}
  PRIVATE_BANKING_MCP_LOCATION=swedencentral